# Server-only production variables. Never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Public/publishable key used only for the persistent Supabase Realtime WebSocket.
# Browser clients still have no SELECT permission on authoritative room/member tables.
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

ONLINE_TURN_SECONDS=45
ONLINE_RECONNECT_GRACE_SECONDS=60
ONLINE_ROOM_HOURS=24
